<Window x:Class="AIBridge.Dialogs.ImageViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Image Viewer - DWN.BRIDGE" 
        Height="600" Width="800"
        WindowStartupLocation="CenterOwner"
        Background="#050505"
        BorderBrush="#222"
        BorderThickness="1"
        Foreground="#FFF">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Area di Visualizzazione Immagine -->
        <ScrollViewer x:Name="ScrollViewer" 
                      Grid.Row="0"
                      HorizontalScrollBarVisibility="Auto" 
                      VerticalScrollBarVisibility="Auto"
                      Background="#0A0A0A"
                      Focusable="False">
            <Grid x:Name="ImageGrid"
                  Background="Transparent"
                  MouseDown="ImageGrid_MouseDown"
                  MouseMove="ImageGrid_MouseMove"
                  MouseUp="ImageGrid_MouseUp"
                  Cursor="Hand"
                  MouseWheel="ImageGrid_MouseWheel">
                <Image x:Name="DisplayImage" 
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Stretch="Uniform"
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center">
                    <Image.LayoutTransform>
                        <ScaleTransform x:Name="ScaleTransform" ScaleX="1.0" ScaleY="1.0"/>
                    </Image.LayoutTransform>
                </Image>
            </Grid>
        </ScrollViewer>

        <!-- Barra di Controllo Inferiore -->
        <Border Grid.Row="1" 
                Background="#0F172A" 
                BorderBrush="#1E293B" 
                BorderThickness="0,1,0,0" 
                Padding="15,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Label di Zoom e Istruzioni -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="ZoomLabel" 
                               Text="Zoom: 100%" 
                               Foreground="#10B981" 
                               FontSize="12" 
                               Margin="0,0,15,0"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Usa la rotellina per lo zoom. Trascina per spostare. ESC per chiudere." 
                               Foreground="#64748B" 
                               FontSize="11" 
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Pulsanti Azione -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <!-- Reset Zoom -->
                    <Button Content="Reset Zoom" 
                            Click="ResetZoom_Click"
                            Background="Transparent"
                            BorderBrush="#334155"
                            Foreground="#CBD5E1"
                            Padding="12,5"
                            FontSize="12"
                            Margin="0,0,10,0"
                            Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    
                    <!-- Apri con App di Sistema -->
                    <Button Content="Apri con App di Sistema" 
                            Click="OpenInSystemApp_Click"
                            Background="#10B981"
                            BorderThickness="0"
                            Foreground="#050505"
                            Padding="15,6"
                            FontWeight="SemiBold"
                            FontSize="12"
                            Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

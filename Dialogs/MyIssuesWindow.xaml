<Window x:Class="AIBridge.Dialogs.MyIssuesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tx="clr-namespace:Unclassified.TxLib;assembly=Unclassified.TxLib"
        Title="{tx:T 'My Submissions'}" Height="550" Width="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1E1E2E" Foreground="White"
        FontFamily="Segoe UI">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <Style x:Key="IssuesActionButton" TargetType="Button">
            <Setter Property="Background" Value="#4A90E2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#2A2A3D"/>
                                <Setter Property="Foreground" Value="#555577"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Title / Refresh -->
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
            <!-- ListView / DataGrid -->
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <!-- Reply Area (Expandable) -->
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <!-- Footer / New Ticket actions -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="{tx:T 'My Support Tickets'}" FontWeight="Bold" FontSize="18" Foreground="White"/>
                <TextBlock Text="{tx:T 'Track the status of your reports and provide additional details if requested.'}" FontSize="12" Foreground="#A0A0C0" Margin="0,2,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Content="{tx:T '🔄 Refresh'}" Style="{StaticResource IssuesActionButton}" Background="#34495E" Click="BtnRefresh_Click" VerticalAlignment="Center"/>
        </Grid>

        <!-- List Grid -->
        <DataGrid Grid.Row="2" x:Name="dgIssues" AutoGenerateColumns="False" IsReadOnly="True"
                  Background="#1E1E2E" Foreground="White" BorderThickness="1" BorderBrush="#3D3D4D"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#3D3D4D"
                  RowBackground="#1E1E2E" AlternatingRowBackground="#252535" SelectionChanged="DgIssues_SelectionChanged">
            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#2D2D3D"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Padding" Value="6,4"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    <Setter Property="BorderBrush" Value="#3D3D4D"/>
                </Style>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#3D3D4D"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="{tx:T 'Date'}" Binding="{Binding SubmitDate, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Width="120"/>
                <DataGridTextColumn Header="{tx:T 'Category'}" Binding="{Binding IssueTypes}" Width="140"/>
                <DataGridTextColumn Header="{tx:T 'Description'}" Binding="{Binding UserDescription}" Width="230"/>
                <DataGridTemplateColumn Header="{tx:T 'Status'}" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="3" Padding="4,1" HorizontalAlignment="Left">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="Open">
                                                <Setter Property="Background" Value="#27AE60"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="InProgress">
                                                <Setter Property="Background" Value="#E67E22"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Resolved">
                                                <Setter Property="Background" Value="#2980B9"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Closed">
                                                <Setter Property="Background" Value="#7F8C8D"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="NeedsInfo">
                                                <Setter Property="Background" Value="#9B59B6"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding Status}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Reply Area (visible only when selected issue status is NeedsInfo) -->
        <Border Grid.Row="4" x:Name="BrdReplyArea" Background="#2A2A3D" BorderBrush="#9B59B6" BorderThickness="1" CornerRadius="5" Padding="10" Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{tx:T '🙋 Info Requested by Admin. Provide additional details:'}" Foreground="#E0B0FF" FontWeight="Bold" FontSize="12"/>
                <TextBlock Grid.Row="2" x:Name="TxtAdminNote" Text="Nota admin: " Foreground="#CCCCCC" FontSize="11" TextWrapping="Wrap" FontStyle="Italic"/>

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Name="TxtReplyInput" Background="#1E1E2E" Foreground="White" BorderBrush="#9B59B6" BorderThickness="1" Padding="5" CaretBrush="White" Height="50" AcceptsReturn="True" TextWrapping="Wrap"/>
                    <Button Grid.Column="2" Content="{tx:T 'Send'}" Style="{StaticResource IssuesActionButton}" Background="#9B59B6" Height="30" VerticalAlignment="Bottom" Click="BtnSendReply_Click"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Footer / Action Area -->
        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <!-- Warning block if active ticket blocks new submission -->
            <TextBlock Grid.Column="0" x:Name="TxtActiveTicketWarning" Text="{tx:T '⚠ You already have a ticket in progress. Please resolve it or wait for completion before submitting a new one.'}" Foreground="#F1C40F" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" Visibility="Collapsed"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnNewTicket" Content="{tx:T 🙋 New Report}" Style="{StaticResource IssuesActionButton}" 
                        Background="#E67E22" Click="BtnNewTicket_Click" Height="32" Width="131"/>
                <Button Content="{tx:T Close}" Style="{StaticResource IssuesActionButton}" 
                        Background="#7F8C8D" Margin="8,0,0,0" IsCancel="True" Height="32" Width="124"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

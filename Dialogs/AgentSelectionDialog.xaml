<Window x:Class="AIBridge.Dialogs.AgentSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Tx="http://unclassified.software/source/txtranslation"
        Title="DWN.Bridge - Agent Selection" MinHeight="450" Width="600"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E2E"
        Foreground="White"
        FontFamily="Segoe UI"
        WindowStyle="ToolWindow">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Tx:T Before starting your DWN.Bridge session choose the Agent you want to work with.}"
                       Foreground="#A0A0C0" FontSize="14" TextWrapping="Wrap" VerticalAlignment="Center" FontWeight="SemiBold"/>
            <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableLanguages}" SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                      Width="130" Height="30" Margin="15,0,0,0" VerticalAlignment="Center"
                      Background="#2D2D4E" Foreground="White" BorderBrush="#3D3D5E" BorderThickness="1"
                      Padding="6,2">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Display}" FontSize="12" Foreground="White"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
                <ComboBox.Style>
                    <Style TargetType="ComboBox">
                        <Setter Property="Background" Value="#252545"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="BorderBrush" Value="#4A4A6A"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBox">
                                    <Grid>
                                        <ToggleButton x:Name="ToggleButton"
                                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                      Background="#252545" BorderBrush="#4A4A6A" BorderThickness="1"
                                                      Cursor="Hand" ClickMode="Press">
                                            <ToggleButton.Template>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="4">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="24"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="1" Text="▾" Foreground="#7B68EE"
                                                                       VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="10"/>
                                                        </Grid>
                                                    </Border>
                                                </ControlTemplate>
                                            </ToggleButton.Template>
                                        </ToggleButton>

                                        <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" 
                                                          Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource TemplatedParent}}"
                                                          ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource TemplatedParent}}"
                                                          ContentTemplateSelector="{Binding ItemTemplateSelector, RelativeSource={RelativeSource TemplatedParent}}"
                                                          Margin="8,2,24,2"
                                                          VerticalAlignment="Center" HorizontalAlignment="Left"/>

                                        <Popup x:Name="Popup" IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                               PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                               Placement="Bottom" AllowsTransparency="True" Focusable="False">
                                            <Border Background="#1E1E2E" BorderBrush="#4A4A6A" BorderThickness="1" CornerRadius="4"
                                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                            </Border>
                                        </Popup>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>

                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#7B68EE"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ComboBox.Style>
                <ComboBox.ItemContainerStyle>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Padding" Value="8,4"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2D2D4E"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#1E3A5F"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ComboBox.ItemContainerStyle>
            </ComboBox>
        </Grid>

        <!-- Agent List -->
        <ListBox Grid.Row="2" ItemsSource="{Binding AvailableAgents}" SelectedItem="{Binding SelectedAgent}"
                 Background="#2D2D4E" Foreground="White" BorderBrush="#7B68EE" BorderThickness="1" 
                 MinHeight="250" MaxHeight="350" ScrollViewer.VerticalScrollBarVisibility="Auto" Margin="0,5,0,15">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Padding" Value="5"/>
                    <Setter Property="Margin" Value="2"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#7B68EE"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#4D4D7E"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="10,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding IconCode}" FontSize="32" VerticalAlignment="Center" Margin="0,0,16,0" FontFamily="Segoe UI Emoji"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                                <Border CornerRadius="3" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Private">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Setter Property="Background" Value="#3B82F6"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Pending">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Setter Property="Background" Value="#F59E0B"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="PendingApproval">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Setter Property="Background" Value="#F59E0B"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Rejected">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Setter Property="Background" Value="#EF4444"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="10" FontWeight="Bold" Foreground="White" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Custom"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Private">
                                                        <Setter Property="Text" Value="{Tx:T Local}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Pending">
                                                        <Setter Property="Text" Value="{Tx:T Pending}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="PendingApproval">
                                                        <Setter Property="Text" Value="{Tx:T Pending}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Rejected">
                                                        <Setter Property="Text" Value="{Tx:T Rejected}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding Description}" Foreground="#D0D0E0" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Buttons -->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <CheckBox x:Name="DontShowAgainCheckBox" Content="{Tx:T Do not show this again}" Foreground="#A0A0C0" VerticalAlignment="Center" Grid.Column="0" FontSize="13"/>
            
            <Button x:Name="SkipButton" Content="{Tx:T Skip}" Grid.Column="1" Height="40" Margin="0,0,10,0" Padding="15,0" MinWidth="100"
                    Background="Transparent" Foreground="#A0A0C0" BorderBrush="#A0A0C0" BorderThickness="1" FontSize="14" Cursor="Hand" Click="SkipButton_Click"/>

            <Button x:Name="StartButton" Content="{Tx:T Start}" Grid.Column="2" Height="40" Padding="25,0" MinWidth="120"
                    Background="#10b981" Foreground="White" BorderThickness="0" FontWeight="Bold" FontSize="16" Cursor="Hand" Click="StartButton_Click"/>
        </Grid>
    </Grid>
</Window>

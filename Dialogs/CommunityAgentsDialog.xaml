<Window x:Class="AIBridge.Dialogs.CommunityAgentsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Tx="http://unclassified.software/source/txtranslation"
        Title="{Tx:T My Custom Agents}" MinHeight="400" Width="550"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E2E"
        Foreground="White"
        FontFamily="Segoe UI">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Tx:T Manage your local agents and submit them to the global AIBridge community!}"
                       Foreground="#A0A0C0" FontSize="14" TextWrapping="Wrap" />
            <Button Grid.Column="1" Content="🔄" FontSize="16" Width="30" Height="30" Margin="10,0,0,0" 
                    Background="Transparent" Foreground="#A0A0C0" BorderThickness="0" Cursor="Hand" ToolTip="Refresh List" Click="RefreshButton_Click"/>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <ComboBox x:Name="FilterComboBox" SelectionChanged="FilterComboBox_SelectionChanged" Width="180" Margin="0,0,10,0" Background="White" Foreground="Black" BorderThickness="0">
                <ComboBoxItem Content="{Tx:T My Custom Agents}" IsSelected="True" />
                <ComboBoxItem Content="{Tx:T Community Agents}" />
            </ComboBox>
            <TextBlock x:Name="TitleLabel" Text="{Tx:T Select agents to submit for approval:}" Foreground="White" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Agent List -->
        <ListBox Grid.Row="2" x:Name="AgentsListBox" Background="#2D2D4E" Foreground="White" BorderBrush="#7B68EE" BorderThickness="1" 
                 MinHeight="150" MaxHeight="300" ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Foreground" Value="White"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#7B68EE"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#4D4D7E"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="4" Width="480">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding Icon}" Margin="0,0,8,0" FontSize="16" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding DisplayName}" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text=" (" Foreground="#A0A0C0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="4" Text="{Binding Status}" Foreground="#4A90E2" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="5" Text=")" Foreground="#A0A0C0" VerticalAlignment="Center"/>
                        
                        <StackPanel Grid.Column="7" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="👁️" Background="Transparent" Foreground="White" BorderThickness="0" Cursor="Hand" Click="ViewScriptButton_Click" ToolTip="{Tx:T View Script}" FontSize="16" Margin="0,0,8,0" Tag="{Binding}"/>
                            <Button Content="🗑️" Background="Transparent" Foreground="#FF6B6B" BorderThickness="0" Cursor="Hand" Click="DeleteAgentButton_Click" ToolTip="{Tx:T Delete Agent}" FontSize="16" Tag="{Binding}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="Approved">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Buttons -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Button x:Name="OpenFolderButton" Content="{Tx:T 📁 Open Local Folder}" Grid.Row="0" Grid.Column="0"
                    Height="35" Margin="0,0,8,8" Background="#3D3D5E" Foreground="White" BorderThickness="0" Click="OpenFolderButton_Click"/>
            
            <Button x:Name="SubmitButton" Content="{Tx:T 🚀 Submit to Community}" Grid.Row="0" Grid.Column="1"
                    Height="35" Margin="8,0,0,8" Background="#7B68EE" Foreground="White" BorderThickness="0" Click="SubmitButton_Click" FontWeight="Bold"/>

            <Button x:Name="GitHubButton" Content="{Tx:T 💻 Open GitHub Repo}" Grid.Row="1" Grid.Column="0"
                    Height="35" Margin="0,8,8,0" Background="#333333" Foreground="White" BorderThickness="0" Click="GitHubButton_Click"/>
            
            <Button x:Name="DiscordButton" Content="{Tx:T 💬 Join Discord}" Grid.Row="1" Grid.Column="1"
                    Height="35" Margin="8,8,0,0" Background="#5865F2" Foreground="White" BorderThickness="0" Click="DiscordButton_Click"/>
        </Grid>
    </Grid>
</Window>

<Window x:Class="AIBridge.Dialogs.ReportIssueDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tx="clr-namespace:Unclassified.TxLib;assembly=Unclassified.TxLib"
        Title="{tx:T 'Report an Issue'}" Height="580" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1E1E2E"
        Foreground="White"
        FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title/Subtitle -->
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/> <!-- Categories Group -->
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>    <!-- Description TextBox -->
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/> <!-- Consent Section -->
            <RowDefinition Height="15"/>
            <RowDefinition Height="Auto"/> <!-- Footer / Version info -->
            <RowDefinition Height="15"/>
            <RowDefinition Height="Auto"/> <!-- Actions -->
        </Grid.RowDefinitions>

        <!-- Title & Subtitle -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="{tx:T 'Report a Problem or Suggest a Feature'}" FontWeight="Bold" FontSize="18" Foreground="White"/>
            <TextBlock Text="{tx:T 'Every submission helps improve the application for the community.'}" FontSize="12" Foreground="#A0A0C0" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Categories Group -->
        <GroupBox Grid.Row="2" Header="{tx:T 'Problem Category (select one or more):'}" Foreground="#A0A0C0" BorderBrush="#3D3D5E" BorderThickness="1" Padding="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="130">
                <StackPanel x:Name="CategoriesPanel">
                    <CheckBox x:Name="CbWorkspace" Content="{tx:T 'Files are not saved in the workspace'}" Foreground="White" Margin="0,3" Checked="Category_Changed" Unchecked="Category_Changed"/>
                    <CheckBox x:Name="CbSyntax" Content="{tx:T 'Agent generated code contains syntax errors'}" Foreground="White" Margin="0,3" Checked="Category_Changed" Unchecked="Category_Changed"/>
                    <CheckBox x:Name="CbCommandExec" Content="{tx:T 'App fails to execute or blocks proposed commands'}" Foreground="White" Margin="0,3" Checked="Category_Changed" Unchecked="Category_Changed"/>
                    <CheckBox x:Name="CbSqlQuery" Content="{tx:T 'SQL database queries or results are incorrect'}" Foreground="White" Margin="0,3" Checked="Category_Changed" Unchecked="Category_Changed"/>
                    <CheckBox x:Name="CbStreamInterrupted" Content="{tx:T 'Agent reply was cut off or is incomplete'}" Foreground="White" Margin="0,3" Checked="Category_Changed" Unchecked="Category_Changed"/>
                    <CheckBox x:Name="CbUiFocus" Content="{tx:T 'Graphics / User interface is not responding correctly'}" Foreground="White" Margin="0,3" Checked="Category_Changed" Unchecked="Category_Changed"/>
                    <CheckBox x:Name="CbAuthLogin" Content="{tx:T 'Authentication or Login failure'}" Foreground="White" Margin="0,3" Checked="Category_Changed" Unchecked="Category_Changed"/>
                    <CheckBox x:Name="CbAgentSync" Content="{tx:T 'Custom agents synchronization failed'}" Foreground="White" Margin="0,3" Checked="Category_Changed" Unchecked="Category_Changed"/>
                    <CheckBox x:Name="CbOther" Content="{tx:T 'Other issue (describe below)'}" Foreground="White" Margin="0,3" Checked="Category_Changed" Unchecked="Category_Changed"/>
                </StackPanel>
            </ScrollViewer>
        </GroupBox>

        <!-- Description TextBox -->
        <DockPanel Grid.Row="4">
            <TextBlock DockPanel.Dock="Top" Text="{tx:T 'Detailed description (minimum 20 characters):'}" Foreground="#A0A0C0" FontSize="12" Margin="0,0,0,4"/>
            <TextBox x:Name="DescriptionTextBox"
                     Background="#2D2D4E" Foreground="White"
                     BorderBrush="#7B68EE" BorderThickness="1"
                     Padding="8" FontSize="13" CaretBrush="White"
                     SelectionBrush="#4A90E2" AcceptsReturn="True" TextWrapping="Wrap"
                     TextChanged="DescriptionTextBox_TextChanged"/>
        </DockPanel>

        <!-- Consent Section -->
        <StackPanel Grid.Row="6">
            <CheckBox x:Name="ConsentCheckBox" Content="{tx:T 'Allow attaching the current active conversation to assist diagnostics'}" Foreground="White" FontWeight="SemiBold" Checked="Consent_Changed" Unchecked="Consent_Changed"/>
            <TextBlock x:Name="SessionInfoTextBlock" Text="Session GUID: None" FontSize="11" Foreground="#4A90E2" Margin="22,4,0,0" Visibility="Collapsed"/>
        </StackPanel>

        <!-- Footer / Version Info -->
        <Border Grid.Row="8" BorderBrush="#2D2D4E" BorderThickness="0,1,0,0" Padding="0,8,0,0">
            <TextBlock x:Name="DiagnosticsTextBlock" Text="Version: 1.0.0 | Agent: Default | OS: Windows" FontSize="11" Foreground="#888888" HorizontalAlignment="Center"/>
        </Border>

        <!-- Actions -->
        <StackPanel Grid.Row="10" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="SendButton" Content="{tx:T '✔ Submit'}"
                    Width="110" Height="30" Margin="0,0,8,0"
                    Background="#4A90E2" Foreground="White" BorderThickness="0"
                    Click="SendButton_Click" IsDefault="True">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="5" Padding="6,3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="btnBorder" Property="Background" Value="#2A2A3D"/>
                                <Setter Property="Foreground" Value="#555577"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#5BA3F5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button x:Name="CancelButton" Content="{tx:T 'Cancel'}"
                    Width="90" Height="30"
                    Background="#3D3D5E" Foreground="#A0A0C0" BorderThickness="0"
                    Click="CancelButton_Click" IsCancel="True">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="6,3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#4D4D6E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Grid>
</Window>

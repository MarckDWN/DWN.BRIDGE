<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>Unclassified.TxLib</AssemblyName>
    <RootNamespace>Unclassified.TxLib</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>

    <!-- Abilita WPF e WinForms richiesti da TxXaml.cs e TxWinForms.cs -->
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>

    <!--
      Sopprime la generazione automatica degli attributi Assembly da parte dell'SDK.
      L'originale Properties\AssemblyInfo.cs è escluso sotto per evitare duplicati
      con i file _wpftmp.csproj generati internamente dal build WPF.
    -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
  </PropertyGroup>

  <!-- Escludi l'AssemblyInfo.cs originale (formato net4.8, incompatibile SDK-style) -->
  <ItemGroup>
    <Compile Remove="Properties\AssemblyInfo.cs" />
  </ItemGroup>

  <!-- log4net: dipendenza di TxLib -->
  <ItemGroup>
    <PackageReference Include="log4net" Version="2.0.17" />
  </ItemGroup>

</Project>
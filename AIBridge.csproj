<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <DefaultItemExcludes>$(DefaultItemExcludes);MdXaml_Source\**</DefaultItemExcludes>
    <ApplicationIcon>aibridge.ico</ApplicationIcon>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <GenerateTargetPlatformAttribute>false</GenerateTargetPlatformAttribute>
    <PlaywrightPlatform>win</PlaywrightPlatform>
    <AssemblyName>DWN.Bridge</AssemblyName>

    <!-- Disattiva il blocco di sicurezza di NuGet che impedisce la pubblicazione in presenza di vulnerabilità note (es. SQLite) -->
    <NuGetAudit>false</NuGetAudit>

    <!-- Rimuove i percorsi locali assoluti della macchina di build dai file .pdb e .dll compilati -->
    <ContinuousIntegrationBuild Condition="'$(DeployOnBuild)' != 'true' And '$(PublishProtocol)' == ''">true</ContinuousIntegrationBuild>
    <ContinuousIntegrationBuild Condition="'$(DeployOnBuild)' == 'true' Or '$(PublishProtocol)' != ''">false</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="localization\languages.txd" />
    <None Remove="aibridge.ico" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="aibridge.ico" />
    <Resource Include="Resources\splash_logo.png" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="localization\languages.txd">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- TxLib è una sottocartella ma è un progetto separato (ProjectReference).
       Il glob SDK includerebbe automaticamente tutti i suoi .cs — lo escludiamo. -->
  <ItemGroup>
    <Compile Remove="TxLib\**" />
    <None Remove="TxLib\**" />
    <Content Remove="TxLib\**" />
    <EmbeddedResource Remove="TxLib\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <ProjectReference Include="MdXaml_Source\MdXaml\MdXaml.csproj" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.9" />
    <PackageReference Include="Microsoft.Playwright" Version="1.60.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4022.49" />
    <PackageReference Include="MySql.Data" Version="9.7.0" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Oracle.ManagedDataAccess.Core" Version="23.26.200" />
    <PackageReference Include="ReverseMarkdown" Version="5.3.0" />
    <PackageReference Include="System.Data.Odbc" Version="10.0.9" />
    <PackageReference Include="System.Data.OleDb" Version="10.0.9" />
    <PackageReference Include="System.Management" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="AIBridge.Shared\AIBridge.Shared.csproj" />
    <ProjectReference Include="TxLib\TxLib.csproj" />
  </ItemGroup>

  <!-- Copia i binari delle estensioni pre-compilate forniti nel repo (AIBridge.Core.dll, AIBridge.ToolCore.dll) -->
  <ItemGroup>
    <None Update="extensions\*.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Escludi i sottoprogetti della solution dal glob implicito del SDK -->
  <ItemGroup>
    <Compile Remove="AIBridge.Shared\**" />
    <Compile Remove="AIBridge.Server\**" />
    <Compile Remove="AIBridge.Core\**" />
    <Compile Remove="AIBridge.LocalPersistence\**" />
    <Compile Remove="AIBridge.ToolCore\**" />
    <Compile Remove="AIBridge.Admin\**" />
    <Compile Remove="AIBridge.Admin.Tests\**" />
    <Compile Remove="AIBridge.WebChat.Tests\**" />
    <EmbeddedResource Remove="AIBridge.Shared\**" />
    <EmbeddedResource Remove="AIBridge.Server\**" />
    <EmbeddedResource Remove="AIBridge.Core\**" />
    <EmbeddedResource Remove="AIBridge.LocalPersistence\**" />
    <EmbeddedResource Remove="AIBridge.ToolCore\**" />
    <EmbeddedResource Remove="AIBridge.Admin\**" />
    <EmbeddedResource Remove="AIBridge.Admin.Tests\**" />
    <EmbeddedResource Remove="AIBridge.WebChat.Tests\**" />
    <Page Remove="AIBridge.Admin\**" />
    <Page Remove="AIBridge.Admin.Tests\**" />
    <Page Remove="AIBridge.WebChat.Tests\**" />
    <None Remove="AIBridge.Shared\**" />
    <None Remove="AIBridge.Server\**" />
    <None Remove="AIBridge.Core\**" />
    <None Remove="AIBridge.LocalPersistence\**" />
    <None Remove="AIBridge.ToolCore\**" />
    <None Remove="AIBridge.Admin\**" />
    <None Remove="AIBridge.Admin.Tests\**" />
    <None Remove="AIBridge.WebChat.Tests\**" />
  </ItemGroup>

</Project>
